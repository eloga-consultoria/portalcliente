const CONFIG={ELOGA_EMAIL:"eloga.contato@gmail.com",SENDER_NAME:"Helle Machado | ELOGA",BOOKING_URL:"https://calendar.app.google/opu1h9YWeJ3hd7YK9",WHATSAPP_URL:"https://wa.me/5511945027978",INSTAGRAM_URL:"https://instagram.com/eloga.saude",SHEET_TITLE:"ELOGA \u2014 Leads do Autodiagn\xf3stico",TAB:"Leads",INCOMPLETE_ALERT_HOURS:24,FOLLOW_UP_B_DAYS:7,REVIEW_C_DAYS:90};const HEADERS=["Recebido em","Cl\xednica","Respons\xe1vel","E-mail","Telefone","Cidade/UF","Segmento","Estrutura","Faturamento","Classe","Nota geral","N\xedvel","Faturamento/ciclo","Financeiro","Comercial","Agenda","Experi\xeancia","Regulat\xf3rio","Prioridades",'Itens "N\xe3o sei"',"Prazo para agendar","Agendou","Lembrete 24h","Lembrete 72h","Aviso interno","Status","Conclu\xeddo em","Origem"];const COL={};HEADERS.forEach((h,i)=>COL[h]=i+1);function doPost(e){const p=e&&e.parameter||{};if(p.website)return json_({ok:true});const lock=LockService.getScriptLock();lock.waitLock(2e4);try{if(String(p.pdf_base64||"").length+String(p.answers_pdf_base64||"").length>12e6)return json_({ok:false,error:"payload"});if(p.stage==="posicionamento")return registrarPosicionamento_(p);if(limiteExcedido_(p))return json_({ok:false,error:"limite"});if(p.stage==="inicio")return registrarInicio_(p);if(p.stage==="ficha")return registrarFicha_(p);return registrarConclusao_(p)}catch(err){console.error(err);try{GmailApp.sendEmail(CONFIG.ELOGA_EMAIL,"Erro ao processar ficha do site",String(err&&err.stack||err)+"\n\n"+(p.form_summary||JSON.stringify(p)))}catch(x){}return json_({ok:false})}finally{lock.releaseLock()}}function registrarInicio_(p){const sh=sheet_();const row=new Array(HEADERS.length).fill("");row[COL["Recebido em"]-1]=new Date;row[COL["Cl\xednica"]-1]=p.clinic_name||"";row[COL["Respons\xe1vel"]-1]=p.lead_name||"";row[COL["E-mail"]-1]=p.lead_email||"";row[COL["Telefone"]-1]=p.lead_phone||"";row[COL["Cidade/UF"]-1]=p.city||"";row[COL["Segmento"]-1]=p.segment||"";row[COL["Status"]-1]="Iniciou";row[COL["Origem"]-1]=p.source||"";sh.appendRow(row);GmailApp.sendEmail(CONFIG.ELOGA_EMAIL,"[In\xedcio] Autodiagn\xf3stico iniciado \u2014 "+(p.clinic_name||"Lead"),"Um novo lead iniciou o autodiagn\xf3stico no site.\n\n"+"Cl\xednica: "+(p.clinic_name||"")+"\nRespons\xe1vel: "+(p.lead_name||"")+"\nE-mail: "+(p.lead_email||"")+"\nTelefone: "+(p.lead_phone||"")+"\nCidade/UF: "+(p.city||"")+"\nSegmento: "+(p.segment||"")+"\nComo conheceu a ELOGA: "+(p.source||"")+"\n\nSe o preenchimento for conclu\xeddo, voc\xea receber\xe1 outro e-mail com o resultado completo.",{name:"Site ELOGA",replyTo:p.lead_email||CONFIG.ELOGA_EMAIL});return json_({ok:true})}function registrarConclusao_(p){const sh=sheet_();const scores=parseScores_(p.scores_json);const deadline=p.deadline_iso?new Date(p.deadline_iso):addDays_(new Date,7);const values={"Cl\xednica":p.clinic_name,"Respons\xe1vel":p.lead_name,"E-mail":p.lead_email,Telefone:p.lead_phone,"Cidade/UF":p.city,Segmento:p.segment,Estrutura:p.structure,Faturamento:p.revenue,Classe:p.lead_class,"Nota geral":Number(p.overall_score)||"","N\xedvel":p.overall_level,"Faturamento/ciclo":scores.fat,Financeiro:scores.fin,Comercial:scores.com,Agenda:scores.age,"Experi\xeancia":scores.exp,"Regulat\xf3rio":scores.reg,Prioridades:p.priorities,'Itens "N\xe3o sei"':Number(p.unknowns)||0,"Prazo para agendar":deadline,Status:"Concluiu","Conclu\xeddo em":new Date};const rowIdx=findStartedRow_(sh,p.lead_email);if(rowIdx){Object.keys(values).forEach(k=>sh.getRange(rowIdx,COL[k]).setValue(values[k]==null?"":values[k]))}else{const row=new Array(HEADERS.length).fill("");row[COL["Recebido em"]-1]=new Date;Object.keys(values).forEach(k=>row[COL[k]-1]=values[k]==null?"":values[k]);sh.appendRow(row)}const pdf=p.pdf_base64?Utilities.newBlob(Utilities.base64Decode(p.pdf_base64),"application/pdf",p.pdf_filename||"Relatorio_Autodiagnostico_ELOGA.pdf"):null;const fichaPdf=p.answers_pdf_base64?Utilities.newBlob(Utilities.base64Decode(p.answers_pdf_base64),"application/pdf",p.answers_pdf_filename||"Ficha_preenchida_ELOGA.pdf"):null;GmailApp.sendEmail(CONFIG.ELOGA_EMAIL,"[Classe "+(p.lead_class||"?")+"] Autodiagn\xf3stico conclu\xeddo \u2014 "+(p.clinic_name||"Lead")+" \u2014 "+(p.overall_score||"?")+"/100","Anexos: relat\xf3rio enviado ao lead e ficha preenchida (uso interno).\n\n"+(p.form_summary||"(sem resumo)"),{name:"Site ELOGA",replyTo:p.lead_email||CONFIG.ELOGA_EMAIL,attachments:[pdf,fichaPdf].filter(Boolean)});if(isEmail_(p.lead_email)){const html=leadEmail_(p,deadline);GmailApp.sendEmail(p.lead_email,"Relat\xf3rio de autodiagn\xf3stico ELOGA \u2014 "+(p.clinic_name||""),stripHtml_(html),{name:CONFIG.SENDER_NAME,replyTo:CONFIG.ELOGA_EMAIL,htmlBody:html,attachments:pdf?[pdf]:[]})}return json_({ok:true})}function findStartedRow_(sh,email){email=String(email||"").trim().toLowerCase();const last=sh.getLastRow();if(!email||last<2)return 0;const data=sh.getRange(2,1,last-1,HEADERS.length).getValues();const limit=addDays_(new Date,-3);for(let i=data.length-1;i>=0;i--){const r=data[i];if(String(r[COL["E-mail"]-1]).trim().toLowerCase()===email&&r[COL["Status"]-1]==="Iniciou"&&new Date(r[COL["Recebido em"]-1])>=limit)return i+2}return 0}function verificarAcompanhamentos(){const sh=sheet_();const last=sh.getLastRow();if(last<2)return;const rows=sh.getRange(2,1,last-1,HEADERS.length).getValues();const booked=bookedEmails_();const now=new Date;rows.forEach((r,i)=>{const row=i+2;const get=k=>r[COL[k]-1];const status=get("Status")||"Concluiu";const cls=get("Classe");const email=String(get("E-mail")||"").trim().toLowerCase();const base=new Date(get("Conclu\xeddo em")||get("Recebido em"));const hours=(now-base)/36e5;const deadline=new Date(get("Prazo para agendar"));const lead={name:get("Respons\xe1vel"),clinic:get("Cl\xednica"),email:email};if(status==="Iniciou"){if(!get("Aviso interno")&&hours>=CONFIG.INCOMPLETE_ALERT_HOURS){GmailApp.sendEmail(CONFIG.ELOGA_EMAIL,"Autodiagn\xf3stico n\xe3o conclu\xeddo: "+lead.clinic,lead.name+" ("+lead.clinic+") iniciou o autodiagn\xf3stico h\xe1 mais de 24 horas e n\xe3o concluiu.\n"+"Telefone: "+get("Telefone")+"\nE-mail: "+email+"\n\nSugest\xe3o: contato pessoal oferecendo apoio no preenchimento.",{name:"Site ELOGA"});sh.getRange(row,COL["Aviso interno"]).setValue(now)}return}if(!get("Agendou")&&email&&booked[email]){sh.getRange(row,COL["Agendou"]).setValue("Sim \u2014 "+Utilities.formatDate(booked[email],tz_(),"dd/MM/yyyy HH:mm"));return}if(get("Agendou"))return;if((cls==="A"||cls==="B")&&isEmail_(email)&&now<deadline){if(hours>=24&&!get("Lembrete 24h")){sendReminder_(lead,deadline,1);sh.getRange(row,COL["Lembrete 24h"]).setValue(now)}else if(hours>=72&&get("Lembrete 24h")&&!get("Lembrete 72h")){sendReminder_(lead,deadline,2);sh.getRange(row,COL["Lembrete 72h"]).setValue(now)}}if(!get("Aviso interno")){if(cls==="B"&&hours>=CONFIG.FOLLOW_UP_B_DAYS*24){GmailApp.sendEmail(CONFIG.ELOGA_EMAIL,"Acompanhamento: "+lead.clinic+" (classe B, 7 dias sem agendar)",lead.name+" ("+lead.clinic+") recebeu o relat\xf3rio h\xe1 7 dias e n\xe3o agendou o diagn\xf3stico completo.\n"+"Sugest\xe3o: contato pessoal por WhatsApp.\nTelefone: "+get("Telefone")+"\nE-mail: "+email+"\nNota geral: "+get("Nota geral")+"/100 \xb7 Prioridades: "+get("Prioridades"),{name:"Site ELOGA"});sh.getRange(row,COL["Aviso interno"]).setValue(now)}else if(cls==="C"&&hours>=CONFIG.REVIEW_C_DAYS*24){GmailApp.sendEmail(CONFIG.ELOGA_EMAIL,"Reavaliar lead: "+lead.clinic+" (classe C, 90 dias)",lead.name+" ("+lead.clinic+") respondeu ao autodiagn\xf3stico h\xe1 90 dias, sem previs\xe3o de decis\xe3o.\n"+"Vale um novo contato para verificar se o momento mudou.\nTelefone: "+get("Telefone")+"\nE-mail: "+email,{name:"Site ELOGA"});sh.getRange(row,COL["Aviso interno"]).setValue(now)}}})}function configurar(){sheet_();ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==="verificarAcompanhamentos").forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger("verificarAcompanhamentos").timeBased().everyHours(1).create();CalendarApp.getDefaultCalendar();console.log("Pronto. Planilha: "+SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty("SHEET_ID")).getUrl())}function leadEmail_(p,deadline){const first=String(p.lead_name||"").split(" ")[0]||"";const intro="<p>Ol\xe1"+(first?", "+esc_(first):"")+".</p><p>Agradecemos o preenchimento do autodiagn\xf3stico ELOGA. O relat\xf3rio da <b>"+esc_(p.clinic_name)+'</b> segue em anexo.</p><p style="font-size:15px"><b>Nota geral: '+esc_(p.overall_score)+"/100 \xb7 N\xedvel "+esc_(p.overall_level)+'</b><br><span style="color:#52656f">Prioridades de atua\xe7\xe3o: '+esc_(p.priorities)+"</span></p>";let next;if(p.lead_class==="C"){next="<p>Quando for o momento de estruturar a gest\xe3o da cl\xednica, a ELOGA permanece \xe0 disposi\xe7\xe3o. Acompanhe os conte\xfados sobre gest\xe3o de cl\xednicas no "+'<a href="'+CONFIG.INSTAGRAM_URL+'">@eloga.saude</a>.</p>'}else{next="<p>A pr\xf3xima etapa \xe9 o <b>diagn\xf3stico completo</b>: um encontro online de 45 minutos para aprofundar os resultados do relat\xf3rio e o contexto da opera\xe7\xe3o. "+"Na sequ\xeancia, voc\xea recebe uma proposta personalizada. O agendamento gratuito fica dispon\xedvel at\xe9 <b>"+fmt_(deadline)+"</b>.</p>"+button_("Agendar diagn\xf3stico completo",CONFIG.BOOKING_URL)}return wrap_(intro+next+signature_())}function sendReminder_(lead,deadline,n){const first=String(lead.name||"").split(" ")[0]||"";const daysLeft=Math.max(1,Math.ceil((deadline-new Date)/864e5));const subject=n===1?"Diagn\xf3stico completo da "+(lead.clinic||"sua cl\xednica")+": agendamento dispon\xedvel":"Faltam "+daysLeft+" dias para agendar o diagn\xf3stico completo";const hello="<p>Ol\xe1"+(first?", "+esc_(first):"")+".</p>";const body=n===1?hello+"<p>O relat\xf3rio de autodiagn\xf3stico da <b>"+esc_(lead.clinic)+"</b> indica o n\xedvel de maturidade de cada setor da opera\xe7\xe3o. "+"No diagn\xf3stico completo, esses resultados s\xe3o aprofundados e convertidos em prioridades concretas para a sua realidade.</p>"+"<p>O agendamento gratuito fica dispon\xedvel at\xe9 <b>"+fmt_(deadline)+"</b>.</p>":hello+"<p>O agendamento gratuito do diagn\xf3stico completo da <b>"+esc_(lead.clinic)+"</b> fica dispon\xedvel at\xe9 <b>"+fmt_(deadline)+'</b>. Se preferir esclarecer d\xfavidas antes, fale pelo <a href="'+CONFIG.WHATSAPP_URL+'">WhatsApp</a>.</p>';const html=wrap_(body+button_("Agendar diagn\xf3stico completo",CONFIG.BOOKING_URL)+signature_());GmailApp.sendEmail(lead.email,subject,stripHtml_(html),{name:CONFIG.SENDER_NAME,replyTo:CONFIG.ELOGA_EMAIL,htmlBody:html})}function signature_(){return'<p style="margin-top:22px">Atenciosamente,<br><b>Helle Machado</b><br><span style="color:#52656f">Fundadora da ELOGA \xb7 Consultoria &amp; Estrat\xe9gias em Sa\xfade<br>'+"eloga.contato@gmail.com \xb7 (11) 94502-7978</span></p>"}function button_(label,url){return'<p style="margin:20px 0"><a href="'+url+'" style="background:#0B1F2A;color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 20px;border-radius:10px;display:inline-block">'+label+"</a></p>"}function wrap_(inner){return'<div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#14242c;max-width:560px">'+'<div style="height:6px;background:linear-gradient(90deg,#607b24,#D8EA00,#25bfae,#6A3BFF);border-radius:4px;margin-bottom:18px"></div>'+inner+"</div>"}function sheet_(){const props=PropertiesService.getScriptProperties();let id=props.getProperty("SHEET_ID"),ss;if(id){try{ss=SpreadsheetApp.openById(id)}catch(e){ss=null}}if(!ss){ss=SpreadsheetApp.create(CONFIG.SHEET_TITLE);props.setProperty("SHEET_ID",ss.getId())}let sh=ss.getSheetByName(CONFIG.TAB);if(!sh){sh=ss.getSheets()[0];sh.setName(CONFIG.TAB)}const head=sh.getLastRow()?sh.getRange(1,1,1,HEADERS.length).getValues()[0]:[];if(head.join("|")!==HEADERS.join("|")){sh.getRange(1,1,1,HEADERS.length).setValues([HEADERS]).setFontWeight("bold").setBackground("#0B1F2A").setFontColor("#ffffff");sh.setFrozenRows(1)}return sh}function bookedEmails_(){const out={};const now=new Date;CalendarApp.getDefaultCalendar().getEvents(addDays_(now,-30),addDays_(now,45)).forEach(ev=>{ev.getGuestList().forEach(g=>{const e=String(g.getEmail()||"").toLowerCase();if(e&&!out[e])out[e]=ev.getStartTime()})});return out}function parseScores_(s){const o={};try{JSON.parse(s||"[]").forEach(x=>o[x.id]=x.score===null?"N/A":x.score)}catch(e){}return o}function isEmail_(e){return/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(e||"").trim())}function addDays_(d,n){const x=new Date(d);x.setDate(x.getDate()+n);return x}function tz_(){return Session.getScriptTimeZone()||"America/Sao_Paulo"}function fmt_(d){return Utilities.formatDate(new Date(d),tz_(),"dd/MM/yyyy")}function esc_(t){return String(t==null?"":t).replace(/[&<>"]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]))}function stripHtml_(h){return h.replace(/<br\s*\/?>/g,"\n").replace(/<\/p>/g,"\n\n").replace(/<[^>]+>/g,"").replace(/&amp;/g,"&").trim()}function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}

/* =====================================================================
   ACRÉSCIMOS — Portal ELOGA v2 (out/2026)
   1) stage "ficha": versões antigas do formulário enviavam a ficha interna
      numa 2ª requisição que caía em registrarConclusao_ e era ENVIADA AO
      LEAD. Agora a ficha vai somente para a ELOGA e não altera a planilha.
   2) stage "posicionamento": PDF enviado pelo portal (edge function), aceito
      apenas com o token secreto. Vai somente para a ELOGA; não grava na
      planilha de leads e não envia nada ao cliente.
   3) Limite simples de envios por e-mail/clínica para conter abuso.
   Configuração: Projeto > Configurações do projeto > Propriedades do script
      PORTAL_TOKEN = (o mesmo valor do segredo APPS_SCRIPT_TOKEN no Supabase)
   ===================================================================== */
function registrarFicha_(p){
  const ficha=p.pdf_base64?Utilities.newBlob(Utilities.base64Decode(p.pdf_base64),"application/pdf",p.pdf_filename||"Ficha_preenchida_ELOGA.pdf"):null;
  GmailApp.sendEmail(CONFIG.ELOGA_EMAIL,"[Ficha] Autodiagnóstico — "+(p.clinic_name||"Lead"),
    "Ficha preenchida (uso interno).\n\n"+(p.form_summary||""),
    {name:"Site ELOGA",attachments:ficha?[ficha]:[]});
  return json_({ok:true});
}
function registrarPosicionamento_(p){
  const esperado=PropertiesService.getScriptProperties().getProperty("PORTAL_TOKEN");
  if(!esperado||String(p.token||"")!==esperado)return json_({ok:false,error:"token"});
  const pdf=p.pdf_base64?Utilities.newBlob(Utilities.base64Decode(p.pdf_base64),"application/pdf",p.pdf_filename||"ELOGA_Posicionamento.pdf"):null;
  GmailApp.sendEmail(CONFIG.ELOGA_EMAIL,"[Portal] Diagnóstico de posicionamento enviado — "+(p.clinic_name||"Cliente"),
    "Um cliente concluiu a ficha de posicionamento no Portal ELOGA.\n\n"+
    "Clínica: "+(p.clinic_name||"")+"\nSegmento: "+(p.segment||"")+"\nCidade: "+(p.city||"")+
    "\nLogin no portal: "+(p.portal_email||"")+"\nEnviado em: "+(p.submitted_at?fmt_(p.submitted_at):"")+
    "\n\nO relatório segue em anexo. O cliente NÃO recebeu este relatório.",
    {name:"Portal ELOGA",attachments:pdf?[pdf]:[]});
  return json_({ok:true});
}
function limiteExcedido_(p){
  const chave="lim_"+String(p.lead_email||p.clinic_name||"anon").toLowerCase().replace(/[^a-z0-9@._-]/g,"").slice(0,80);
  const cache=CacheService.getScriptCache();
  const n=Number(cache.get(chave)||0)+1;
  cache.put(chave,String(n),600);
  return n>6;
}
